{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openrqm-client",
  "version": "0.0.1",
  "identifier": "org.openrqm.client",
  "build": {
    "frontendDist": "../dist/openrqm-client-desktop-nwjs",
    "devUrl": "http://localhost:4201",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRQM Client",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "store": {}
  }
}
